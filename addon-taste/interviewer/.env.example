# Copier en .env.local et remplir. NE JAMAIS committer .env.local.

# Requis — ta clé Anthropic (serveur uniquement, jamais exposée au client)
ANTHROPIC_API_KEY=

# Optionnel — modèle (défaut: claude-sonnet-4-6 ; mets un modèle opus pour plus tranchant)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optionnel — code d'accès partagé aux invités (sinon l'URL est ouverte à tous)
ACCESS_CODE=

# Optionnel — persistance des fiches (sans, l'app marche et affiche juste la fiche)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
