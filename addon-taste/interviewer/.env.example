# Copier en .env.local et remplir. NE JAMAIS committer .env.local.

# ── 1. Modèle (bascule sans toucher au code) ─────────────────────────
# anthropic (défaut) = API Anthropic ; openai = toute gateway compatible-OpenAI
# (Thiga, OpenAI, OpenRouter, ou un modèle LOCAL type Ollama/LM Studio).
LLM_PROVIDER=anthropic

# Si LLM_PROVIDER=anthropic :
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Si LLM_PROVIDER=openai :
OPENAI_BASE_URL=https://models.thiga.co/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── 2. Stockage (n'impose aucun service) ─────────────────────────────
# Auto-détecté ; ou force avec STORE=supabase|postgres|none.
#   supabase → renseigne SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#   postgres → renseigne POSTGRES_URL (n'importe quel Postgres : Neon, Railway, VPS, LOCAL)
#   none     → pas de persistance (fiche affichée/téléchargée ; PIN non appliqué)
# STORE=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
# POSTGRES_SSL=true   # si ton Postgres exige le SSL et que l'URL ne le précise pas

# ── 3. Reste ─────────────────────────────────────────────────────────
# Code d'accès partagé aux invités (sinon l'URL est ouverte à tous)
ACCESS_CODE=
# Sel pour hasher les codes (mets une valeur aléatoire en prod)
PIN_SALT=
# Nom de l'opérateur, affiché dans le bandeau de transparence (vide = « l'opérateur de cette instance »)
OPERATOR_NAME=
# Clé pour la collecte opérateur : /api/export?key=...  (vide = export désactivé)
OPERATOR_KEY=
